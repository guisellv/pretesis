# Variables para docker compose. Copiar como .env (en la raíz del proyecto) y completar.

# Base de datos: el contenedor "db" (PostgreSQL) crea este usuario y esta base la primera vez
DB_USERNAME=postgres
PASSWORD=cambia_esta_clave
DATABASE=agenda

# Autenticación
JWT_SECRET=cambia_este_secreto

# Correo para recuperar contraseña (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
