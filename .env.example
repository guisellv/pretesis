# Variables para docker compose. Copiar como .env (en la raíz del proyecto) y completar.

# Base de datos: el contenedor "db" (PostgreSQL) crea este usuario y esta base la primera vez
DB_USERNAME=postgres
PASSWORD=cambia_esta_clave
DATABASE=agenda

# Autenticación
JWT_SECRET=cambia_este_secreto

# Correo para recuperar contraseña y avisos de cambios (opcional).
# Si se deja vacío, los correos se muestran en la consola del backend.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y en SMTP_PASS una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dirección de la aplicación, para el botón "Ir a la agenda" de los correos (opcional)
APP_URL=
