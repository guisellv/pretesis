# Copiar este archivo como .env y completar los valores.
# Todas las variables se leen en src/config/configEnv.ts

# Servidor
PORT=3001

# Base de datos (PostgreSQL)
HOST=localhost
DB_PORT=5432
DB_USERNAME=
PASSWORD=
DATABASE=

# Autenticación
JWT_SECRET=

# Correo para recuperar contraseña y avisos de cambios (opcional).
# Si se deja vacío, los correos se muestran en la consola del backend.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y en SMTP_PASS una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dirección de la aplicación, para el botón "Ir a la agenda" de los correos (opcional)
APP_URL=
