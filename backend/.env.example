# Copiar este archivo como .env y completar los valores.
# Todas las variables se leen en src/config/configEnv.ts

# Servidor
PORT=3001

# Base de datos (PostgreSQL)
HOST=localhost
DB_PORT=5432
DB_USERNAME=
PASSWORD=
DATABASE=

# Autenticación
JWT_SECRET=

# Correo para recuperar contraseña (opcional).
# Si se deja vacío, el código de recuperación se muestra en la consola del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
